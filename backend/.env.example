# Порт API
PORT=3000
# Секрет для JWT — обов'язково змініть у продакшні
JWT_SECRET=dev-secret-change-me
# Дозволені origin для CORS (через кому). Порожньо — дозволено всі (для розробки)
# CORS_ORIGIN=http://localhost:5173
# PostgreSQL. Якщо не задано — використовується локальний файл SQLite data/business-navigator.sqlite
# DATABASE_URL=postgres://user:password@localhost:5432/business_navigator
# SEED=false  # вимкнути автоматичне заповнення демо-даними
